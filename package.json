{
  "name": "usora",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "affected": "bun tooling/affected-plugins.ts",
    "benchmark:foundry": "bun scripts/foundry-token-benchmark.ts",
    "build": "bun tooling/build-plugin.ts",
    "build:foundry": "bun tooling/build-plugin.ts foundry",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run package:check && bun run runtime:check && bun run marketplace:check && bun run test && bun run validate",
    "discover": "bun tooling/discover-plugins.ts",
    "doctor": "bun scripts/validate-plugin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "marketplace:build": "bun tooling/sync-marketplace.ts && bun tooling/build-marketplace.ts",
    "marketplace:check": "bun tooling/sync-marketplace.ts --check && bun tooling/build-marketplace.ts --check",
    "package": "bun tooling/package-plugin.ts",
    "package:check": "bun tooling/package-plugin.ts --check",
    "package:foundry": "bun tooling/package-plugin.ts foundry",
    "plugin:create": "bun tooling/create-plugin.ts",
    "prepare": "husky",
    "release": "bun run release:plugins",
    "release:ci": "bun tooling/release-ci.ts",
    "release:marketplace": "bun tooling/publish-marketplace-branch.ts",
    "release:plan": "bun tooling/release-plan.ts",
    "release:plugins": "bun tooling/release-plugin.ts",
    "release:version": "bun tooling/version-plugin.ts",
    "runtime:check": "bun tooling/clean-runtime-test.ts",
    "sync": "bun tooling/sync-marketplace.ts && prettier --write marketplace.json .agents/plugins/marketplace.json .claude-plugin/marketplace.json .codebuddy-plugin/marketplace.json 'plugins/*/.mcp.json' 'plugins/*/.codex-plugin/plugin.json' 'plugins/*/.codebuddy-plugin/*.json' 'plugins/*/hooks/codex-hooks.json' 'plugins/*/hooks/codebuddy-hooks.json'",
    "sync:release": "bun tooling/sync-marketplace.ts && prettier --write marketplace.json .agents/plugins/marketplace.json .claude-plugin/marketplace.json .codebuddy-plugin/marketplace.json 'plugins/*/.mcp.json' 'plugins/*/.codex-plugin/plugin.json' 'plugins/*/.codebuddy-plugin/*.json' 'plugins/*/hooks/codex-hooks.json' 'plugins/*/hooks/codebuddy-hooks.json'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "bun scripts/validate-plugin.ts"
  },
  "lint-staged": {
    "*.{js,cjs,ts,mts}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.78.0",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.14"
}
