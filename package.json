{
  "name": "usora",
  "version": "0.3.15",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm test && npm run validate",
    "doctor": "node scripts/plugin.mjs doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "plugin": "node scripts/plugin.mjs",
    "prepare": "husky",
    "sync": "node scripts/plugin.mjs sync && prettier --write plugin.json common/marketplace.json marketplace.json .agents/plugins/marketplace.json .mcp.json .codex-plugin/plugin.json .codebuddy-plugin/plugin.json .codebuddy-plugin/marketplace.json package.json",
    "test": "node --test scripts/usora-mcp.test.mjs",
    "validate": "node scripts/validate-plugin.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.78.0",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2"
  }
}
